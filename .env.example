# Copy to .env and adjust. .env is gitignored — never commit it.
# This milestone serves market configuration only, so no API keys are needed.

# Transport: stdio for Claude Desktop / Claude Code, http for ChatGPT connectors.
MCP_TRANSPORT=stdio

# HTTP transport only.
PORT=8787
HOST=0.0.0.0

# Override the market data directory. Defaults to the repo's data/ folder.
# PLU_MARKET_DATA_DIR=/etc/getplu/data

# Server log level: debug | info | warn | error
# Logs go to stderr — stdout is reserved for the MCP protocol stream.
LOG_LEVEL=info
