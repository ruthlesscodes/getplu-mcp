# Copy to .env and fill in real values. .env is gitignored — never commit it.

# GetPlu API key. Use a sandbox key for local development.
PLU_API_KEY=plu_sk_sandbox_replace_me

# Base URL of the GetPlu REST API.
PLU_API_BASE_URL=https://api.getplu.com/v1

# Which GetPlu environment the key belongs to: sandbox | live
PLU_ENVIRONMENT=sandbox

# Per-request timeout in milliseconds.
PLU_REQUEST_TIMEOUT_MS=15000

# Server log level: debug | info | warn | error
# Logs go to stderr — stdout is reserved for the MCP protocol stream.
LOG_LEVEL=info
